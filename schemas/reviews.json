{
  "name": "reviews",
  "description": "Manual product review moderation queue.",
  "fields": {
    "product_id": {
      "type": "string",
      "ref": "products"
    },
    "customer_id": {
      "type": "string",
      "ref": "customers"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "published"
      ]
    }
  },
  "writable": true,
  "unique": []
}
