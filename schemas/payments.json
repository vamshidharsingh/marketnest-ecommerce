{
  "name": "payments",
  "description": "Simulated checkout payment confirmations; no card processing.",
  "fields": {
    "order_id": {
      "type": "string",
      "ref": "orders"
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "simulated",
        "refunded"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "demo"
      ]
    }
  },
  "writable": false,
  "unique": [
    "order_id"
  ]
}
