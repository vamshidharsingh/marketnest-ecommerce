{
  "name": "orders",
  "description": "Atomic checkout totals; payment status is explicitly simulated.",
  "fields": {
    "customer_id": {
      "type": "string",
      "ref": "customers"
    },
    "cart_id": {
      "type": "string",
      "ref": "carts"
    },
    "subtotal_cents": {
      "type": "integer",
      "minimum": 0
    },
    "discount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "total_cents": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "placed",
        "refunded"
      ]
    },
    "key": {
      "type": "string"
    }
  },
  "writable": false,
  "unique": [
    "key",
    "cart_id"
  ]
}
